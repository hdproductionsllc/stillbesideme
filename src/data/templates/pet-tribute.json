{
  "id": "pet-tribute",
  "name": "Pet Tribute",
  "collection": "pet-memorial",
  "description": "A personalized poem written from your memories, printed beside your pet's photo – an archival, museum-quality print, framed and made to last a lifetime.",
  "category": "pet",
  "poemSupport": "ai",
  "colorMode": "auto",
  "printSpec": { "matBorderIn": 1.5, "gutterIn": 1.0, "bevelWidthIn": 0.1 },

  "canvas": {
    "width": 4800,
    "height": 6000,
    "dpi": 300,
    "background": "#1a1a1a"
  },

  "layouts": {
    "side-by-side": {
      "label": "Landscape",
      "panels": 2,
      "columns": [1, 1],
      "rows": [1],
      "areas": [["photo", "tribute"]],
      "aspectRatio": "5/3.2"
    },
    "stacked": {
      "label": "Portrait",
      "panels": 2,
      "columns": [1],
      "rows": [1, 1],
      "areas": [["photo"], ["tribute"]],
      "aspectRatio": "4/5"
    }
  },

  "styleVariants": {
    "classic-dark": {
      "label": "Classic Dark",
      "description": "Black wood frame, elegant dark background, cream and gold text – timeless and premium",
      "frame": {
        "gradient": "linear-gradient(145deg, #232323, #2e2e2e 15%, #101010 40%, #1c1c1c 70%, #0a0a0a)",
        "shadow": "0 4px 24px rgba(0,0,0,0.5)"
      },
      "mat": { "color": "#1a1a1a" },
      "tribute": {
        "background": "#1a1a1a",
        "name": "#FAF8F5",
        "dates": "#9B9590",
        "divider": "#C4A882",
        "poem": "#C4A882",
        "nickname": "#9B9590",
        "family": "#9B9590"
      },
      "photo": {
        "borderColor": "#C4A882"
      }
    }
  },

  "tributeMapping": {
    "name": "petName",
    "nickname": "petNicknames",
    "familyName": "familyName",
    "familyPrefix": "Beloved companion of",
    "birthDate": "birthDate",
    "passDate": "passDate",
    "poemText": "poemText"
  },

  "poemLabel": "Poem",

  "poemFormats": [
    { "id": "poem", "label": "A poem about them", "poemLabel": "Poem" },
    { "id": "letter", "label": "A letter from them", "poemLabel": "Letter" }
  ],

  "giftLabels": {
    "gift": {
      "petName": "What was their pet's name?",
      "petNicknames": "Any nicknames you know?",
      "petType": "What kind of pet?",
      "personality": "What made this pet special?",
      "favoriteMemory": "A memory you've heard about",
      "favoriteThing": "A favorite toy or treat you know of?",
      "familyName": "Who is this gift for?"
    },
    "self": {
      "petName": "What did you call them?",
      "petNicknames": "Any nicknames?",
      "petType": "What kind of companion?",
      "personality": "What made them special?",
      "favoriteMemory": "A favorite memory",
      "favoriteThing": "Their favorite toy or treat?",
      "familyName": "Who will miss them most?"
    }
  },

  "formLabels": {
    "poemSectionTitle": "Now let's write their tribute poem",
    "poemLibraryLink": "Or choose from our poem library instead"
  },

  "defaultStyle": "classic-dark",
  "defaultLayout": "side-by-side",

  "photoSlots": [
    { "id": "main", "label": "Share their photo", "sublabel": "The one that captures who they really were", "required": true }
  ],

  "memoryFields": [
    { "id": "petName", "label": "What did you call them?", "type": "text", "required": true, "maxLength": 40, "displayOn": "tribute" },
    { "id": "petNicknames", "label": "Any nicknames?", "sublabel": "The silly ones count too", "type": "text", "required": false, "maxLength": 80, "placeholder": "Mr. Wigglebutt, Buddy Bear, The Senator", "displayOn": "tribute", "feedsPoem": true },
    { "id": "petType", "label": "What kind of companion?", "type": "select", "options": ["Dog", "Cat", "Bird", "Horse", "Rabbit", "Other"], "required": true, "feedsPoem": true },
    { "id": "breed", "label": "Breed", "type": "text", "required": false, "maxLength": 40, "feedsPoem": true },
    { "id": "birthDate", "label": "When were they born?", "sublabel": "Year or full date", "type": "text", "required": false, "maxLength": 20, "placeholder": "2014", "displayOn": "tribute" },
    { "id": "passDate", "label": "When did they cross the rainbow bridge?", "sublabel": "Year or full date", "type": "text", "required": false, "maxLength": 20, "placeholder": "2026", "displayOn": "tribute" },
    { "id": "personality", "label": "What made them special?", "sublabel": "The thing that made them uniquely yours", "type": "textarea", "required": false, "maxLength": 200, "feedsPoem": true },
    { "id": "favoriteMemory", "label": "A favorite memory", "sublabel": "The one that makes you smile through tears", "type": "textarea", "required": false, "maxLength": 300, "feedsPoem": true },
    { "id": "favoriteThing", "label": "Their favorite toy or treat?", "sublabel": "The thing they couldn't live without", "type": "text", "required": false, "maxLength": 60, "feedsPoem": true },
    { "id": "familyName", "label": "Who will miss them most?", "sublabel": "Your family name or your name", "type": "text", "required": false, "maxLength": 80, "placeholder": "The Hamilton family", "displayOn": "tribute" },
    { "id": "poemText", "label": "Tribute poem", "type": "poem-selector" }
  ],

  "printProducts": [
    { "sku": "framed-8x10", "label": "Framed 8×10\"", "price": 7900, "badge": "Gift Size" },
    { "sku": "framed-11x14", "label": "Framed 11×14\"", "price": 11900, "default": true, "badge": "Most Popular" },
    { "sku": "framed-16x20", "label": "Framed 16×20\"", "price": 16900 },
    { "sku": "framed-20x30", "label": "Framed 20×30\"", "price": 24900, "badge": "Statement Piece" },
    { "sku": "print-11x14", "label": "Print only 11×14\"", "sublabel": "The same archival print, ready for your own frame", "price": 3900 },
    { "sku": "digital-11x14", "label": "Digital Keepsake", "sublabel": "A printable high-resolution file of their tribute", "price": 1995, "fulfillment": "digital" }
  ],

  "frameOptions": {
    "default": "black",
    "groups": [
      {
        "label": "Frame",
        "tier": "included",
        "upchargeCents": 0,
        "note": "Slim 0.9\" gallery profile, solid wood - included with every size.",
        "choices": [
          { "id": "black",   "label": "Black",        "luma": 105001, "faceIn": 0.875, "swatch": "#1c1c1c", "molding": "linear-gradient(145deg, #232323, #2e2e2e 15%, #101010 40%, #1c1c1c 70%, #0a0a0a)", "default": true },
          { "id": "white",   "label": "White",        "luma": 105002, "faceIn": 0.875, "swatch": "#eeeae1", "molding": "linear-gradient(145deg, #fbf9f4, #ffffff 15%, #e4ded3 45%, #f0ebe2 70%, #d9d2c5)" },
          { "id": "oak",     "label": "Oak",          "luma": 105003, "faceIn": 0.875, "swatch": "#c8a97e", "molding": "linear-gradient(145deg, #d8b988, #e6cfa3 15%, #b58e5f 45%, #cba97f 70%, #a97e50)" },
          { "id": "natural", "label": "Natural Wood", "luma": 105008, "faceIn": 0.875, "swatch": "#b5895a", "molding": "linear-gradient(145deg, #c99a63, #d8ac74 15%, #a2703f 45%, #b98a52 70%, #8f6234)" }
        ]
      },
      {
        "label": "Signature frames",
        "tier": "signature",
        "upchargeCents": 6000,
        "note": "Wide 3\" hand-finished solid-wood profiles - over triple the depth of the standard frame, with a sculpted ornate face. A heavier, gallery-weight piece that becomes the centerpiece of the wall.",
        "choices": [
          { "id": "driftwood", "label": "Driftwood Gray",      "luma": 105018, "faceIn": 3.0,    "swatch": "#9b978e", "molding": "linear-gradient(145deg, #a8a49b, #b8b4ab 15%, #86827a 45%, #9b978e 70%, #6f6b63)" },
          { "id": "pleinair",  "label": "Plein Air Espresso",  "luma": 105020, "faceIn": 2.5625, "swatch": "#4a3b2e", "molding": "linear-gradient(145deg, #5a4636, #6b5340 15%, #3a2c20 45%, #4a3b2e 70%, #2c2018)" },
          { "id": "copper",    "label": "Vintage Copper",      "luma": 105021, "faceIn": 3.25,   "swatch": "#a56a3f", "molding": "linear-gradient(145deg, #c07d4c, #d18f5a 15%, #8a4f2c 45%, #a56a3f 70%, #6f3d20)" }
        ]
      }
    ]
  }
}
