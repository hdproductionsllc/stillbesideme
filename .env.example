PORT=3001
NODE_ENV=development
SESSION_SECRET=change-me-to-a-random-string

# Required for AI poem generation — falls back to template poem if missing
ANTHROPIC_API_KEY=sk-ant-placeholder

# Stripe Payment
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_PUBLISHABLE_KEY=pk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder

BASE_URL=http://localhost:3001

# WHCC Print Lab (sandbox credentials for testing)
WHCC_ORDER_API_URL=https://sandbox.apps.whcc.com
WHCC_CONSUMER_KEY=your-consumer-key
WHCC_CONSUMER_SECRET=your-consumer-secret
WHCC_EDITOR_API_URL=https://prospector-stage.dragdrop.design
WHCC_EDITOR_KEY_ID=your-editor-key-id
WHCC_EDITOR_KEY_SECRET=your-editor-key-secret
WHCC_ENVIRONMENT=sandbox

# Luma Prints (primary fulfillment provider)
LUMA_API_KEY=your-luma-api-key
LUMA_API_SECRET=your-luma-api-secret
LUMA_ENVIRONMENT=sandbox
LUMA_STORE_ID=

# Fulfillment provider: 'luma' (primary), 'partner' (print shop via email), or 'whcc'
# Defaults to 'luma' when unset.
FULFILLMENT_PROVIDER=luma

# Partner UV print shop — receives the print file + order email on proof approval
PARTNER_PRINT_EMAIL=printshop@example.com

# Email (proof approval workflow) — works with any SMTP provider (Resend, SendGrid, Gmail, Mailtrap)
# If SMTP_HOST is not set, emails are logged to console but not sent
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=587
# SMTP_USER=resend
# SMTP_PASS=re_your_api_key
# EMAIL_FROM=Still Beside Me <hello@stillbesideme.com>
# Review-gate + change-request notifications. Comma-separated for multiple
# reviewers (David + Rebecca). REQUIRED in production: without it, paid orders
# sit in awaiting_review with no notification.
# ADMIN_EMAIL=david@stillbesideme.com,rebecca@stillbesideme.com

# Error Monitoring (Sentry — free tier)
# SENTRY_DSN=https://your-dsn@sentry.io/project-id

# Analytics & Ads (placeholder IDs until accounts created)
# Served to the browser via GET /js/env.js as window.SBM_ENV — only set keys are exposed
# META_PIXEL_ID=your-meta-pixel-id
# GOOGLE_ADS_ID=AW-your-google-ads-id
# GOOGLE_ADS_CONVERSION_LABEL=your-conversion-label

# Mailchimp (marketing email capture — free tier)
# MAILCHIMP_API_KEY=your-api-key-us21
# MAILCHIMP_LIST_ID=your-audience-list-id

# Customer review invitations. OFF unless this is exactly 'true'. When on, a
# daily timer asks each customer once, 10 days after their piece shipped, how it
# turned out. Only orders that shipped within the last 60 days are ever asked,
# so switching it on cannot email the whole back catalogue at once.
# REVIEW_INVITES_ENABLED=true

# Admin dashboard password. Without it /admin returns 503, which also means the
# review moderation queue is unreachable and nothing can be published.
# ADMIN_PASSWORD=

# Persistent storage paths (defaults to project-relative dirs for local dev)
# On Railway: set these to a mounted volume, e.g. /data, /data/uploads, /data/output
# DATA_DIR=/data
# UPLOADS_DIR=/data/uploads
# OUTPUT_DIR=/data/output
